{"_id":"APOFtblRumors001","name":"Dry Dock Rumors","img":"","description":"<p>Rumors heard at the Dry Dock (100cr per roll).</p>","results":[{"_id":"APOFrslt00000001","range":[1,1],"text":"There's creatures growing in The Choke.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000002","range":[2,2],"text":"Yandee is secretly an android.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000003","range":[3,3],"text":"Cutter is looking to overthrow Yandee.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000004","range":[4,4],"text":"Ukko/Ukka is a Hunglung sympathizer.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000005","range":[5,5],"text":"Imogene Kane is planning an uprising.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000006","range":[6,6],"text":"Sycorax makes installing cybermods easy.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000007","range":[7,7],"text":"Angus knows everything about everyone.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000008","range":[8,8],"text":"Brunhildh keeps a pet monster in the cells.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000009","range":[9,9],"text":"Something called \"Caliban\" is infecting the terminals.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000010","range":[10,10],"text":"The Aarnivalkea can heal any disease.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblShipsDckd","name":"Ships Currently Docked","img":"","description":"<p>Ships currently docked at the Dry Dock.</p>","results":[{"_id":"APOFrslt00000011","range":[1,1],"text":"<strong>Conquer All</strong> - Looking for gunmen. Leaves tomorrow. 6 mos Salary + Hazard Pay.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000012","range":[2,2],"text":"<strong>Bartzabel</strong> - Strikebreakers heading to Tybalt Blue research station. 6 mos Salary.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000013","range":[3,3],"text":"<strong>Decade of Therion</strong> - Blockade runner heading to DMZ. Room for 5. Tickets 20kcr/ea.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000014","range":[4,4],"text":"<strong>Horns of Baphomet</strong> - Rescue mission. Looking for a ship called The Defiance.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000015","range":[5,5],"text":"<strong>In the Absence ov Light</strong> - Needs 2 scientists, heading to remote research station for 3 weeks. 2 mos Salary + 1 mo Hazard Pay.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000016","range":[6,6],"text":"<strong>Ov Fire and Void</strong> - Smuggler looking for work. 1.5kcr advance and 10% of profits.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000017","range":[7,7],"text":"<strong>Daimonos</strong> - Needs 100 doses of Sycorax.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000018","range":[8,8],"text":"<strong>Alas, Lord is Upon Me</strong> - Mining crew taking apprentices. 3 mos Salary.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000019","range":[9,9],"text":"<strong>Inner Sanctum</strong> - Solarians on a pilgrimage to Päivätär 1019. Will take anyone.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000020","range":[10,10],"text":"<strong>From the Pagan Vastlands</strong> - Sensitive cargo heading to the Thelema Sector. Guards needed. 1 mo Salary + 1 mo Hazard Pay.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblBabushkaJ","name":"Jobs for The Babushka","img":"","description":"<p>Jobs offered by The Babushka at The Chop Shop.</p>","results":[{"_id":"APOFrslt00000021","range":[1,4],"text":"1d5 infected corpses. Bring them here for study. Don't get sick. <strong>Pay: 2kcr/ea.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":4,"drawn":false,"flags":{}},{"_id":"APOFrslt00000022","range":[5,6],"text":"Sycorax pickup from The Farm. Talk to Ukko/Ukka, no one else. <strong>Pay: 3kcr</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000023","range":[7,8],"text":"House call. Mutated patient has mysteriously died in their home. Visit the scene and collect evidence. Don't get sick. <strong>Pay: 15kcr</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000024","range":[9,9],"text":"Rumors of a Dr. Bancali modding patients in The Choke. Visit Doptown and track him down. See if he knows what's going on with the ACMD outbreak. <strong>Pay: Free cybermod</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000025","range":[10,10],"text":"Yandee has called The Babushka in for a meeting. Provide protection. <strong>Pay: 40kcr</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblCybrMlfnc","name":"Cybermod Malfunctions","img":"","description":"<p>Roll when cybermod installation fails or malfunctions.</p>","results":[{"_id":"APOFrslt00000026","range":[0,14],"text":"<strong>Loud.</strong> Squeaks, rings or hums near-constantly, making stealth difficult and peace of mind impossible. +1 minimum Stress.","type":0,"documentCollection":"","documentId":null,"img":"","weight":15,"drawn":false,"flags":{}},{"_id":"APOFrslt00000027","range":[15,29],"text":"<strong>Ghastly.</strong> People are unnerved to have you around and stare at you. +2 minimum Stress.","type":0,"documentCollection":"","documentId":null,"img":"","weight":15,"drawn":false,"flags":{}},{"_id":"APOFrslt00000028","range":[30,44],"text":"<strong>Irritating.</strong> Itches, twitches, and sends chills down your spine. Stress reduction is halved.","type":0,"documentCollection":"","documentId":null,"img":"","weight":15,"drawn":false,"flags":{}},{"_id":"APOFrslt00000029","range":[45,59],"text":"<strong>Painful.</strong> Constant source of chronic pain. Health restoration (through rest or otherwise) is halved.","type":0,"documentCollection":"","documentId":null,"img":"","weight":15,"drawn":false,"flags":{}},{"_id":"APOFrslt00000030","range":[60,74],"text":"<strong>Sickly.</strong> Your body doesn't play well with the intrusive mod. Body Save reduced by 1d5.","type":0,"documentCollection":"","documentId":null,"img":"","weight":15,"drawn":false,"flags":{}},{"_id":"APOFrslt00000031","range":[75,89],"text":"<strong>Fragile.</strong> Prone to breakage. Whenever you critically fail a Body Save the mod breaks down. Requires 10% base cost to repair.","type":0,"documentCollection":"","documentId":null,"img":"","weight":15,"drawn":false,"flags":{}},{"_id":"APOFrslt00000032","range":[90,90],"text":"<strong>Knockoff.</strong> Cheaply made version of whatever you thought you were getting. Whatever effect the mod had is now halved.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000033","range":[91,91],"text":"<strong>Complicated.</strong> Install needs additional work. Come back for another session and pay 10% of base price to get it up and running.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000034","range":[92,92],"text":"<strong>Finnicky.</strong> Requires 1d10kcr in repairs every 1d10 months.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000035","range":[93,93],"text":"<strong>Poor Fit.</strong> The mod takes up one more slot than it's supposed to.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000036","range":[94,94],"text":"<strong>Traumatizing.</strong> The mod overwhelms your mental capacity. Forget a random Skill.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000037","range":[95,95],"text":"<strong>Interference.</strong> Causes static and problems with functioning electronic equipment in Close Range.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000038","range":[96,96],"text":"<strong>Underpowered.</strong> Requires a permanent 1 slot battery pack to work properly (costs 2kcr).","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000039","range":[97,97],"text":"<strong>Poorly Designed.</strong> Pay your engineers better! Permanently breaks down in 2d10 days.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000040","range":[98,98],"text":"<strong>Mutation.</strong> Mod messes with your system. Roll a Random Mutation.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000041","range":[99,99],"text":"<strong>Lemon.</strong> Roll twice and combine.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d100-1","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblCybrPanic","name":"Cybermod Panic Table","img":"","description":"<p>Alternative Panic Table for characters with cybermods.</p>","results":[{"_id":"APOFrslt00000042","range":[1,1],"text":"<strong>Endorphin Flood.</strong> Reduce 1d5 Stress.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000043","range":[2,2],"text":"<strong>Biofeedback.</strong> Regain 2d10 Health.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000044","range":[3,3],"text":"<strong>Uplift.</strong> Gain a random Skill for 1d10 days.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000045","range":[4,5],"text":"<strong>Glitch.</strong> Sanity Save or 1d5 Stress.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000046","range":[6,7],"text":"<strong>Out of Batteries.</strong> All mods stop working unless you are hooked into a power source.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000047","range":[8,9],"text":"<strong>Power Surge.</strong> Take Xd10 DMG where X equals the number of slots installed.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000048","range":[10,11],"text":"<strong>Shutdown.</strong> A random mod stops working completely until it is repaired.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000049","range":[12,13],"text":"<strong>Reboot.</strong> Forget the last 1d10 days.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000050","range":[14,15],"text":"<strong>Immune Response.</strong> Reduce your total slots by 1.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000051","range":[16,17],"text":"<strong>Overload.</strong> Random mod explodes, dealing Xd10 DMG where X equals the mod's slots.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000052","range":[18,18],"text":"<strong>Mindwipe.</strong> Forget a random Skill.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000053","range":[19,19],"text":"<strong>Loss of Humanity.</strong> Fear Saves made in your presence are now at [-].","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000054","range":[20,20],"text":"<strong>I, Robot.</strong> In 1d10 rounds the mod takes over and you become a machine controlled by the Warden.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d20","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblDrugEffct","name":"Drug Effects","img":"","description":"<p>Random drugs available on Prospero's Dream.</p>","results":[{"_id":"APOFrslt00000055","range":[1,1],"text":"<strong>Method (80cr).</strong> Complete and total eidetic memory for 2d10 minutes.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000056","range":[2,2],"text":"<strong>Liquid Sword (200cr).</strong> [+] on Combat Checks for 1d5 turns. Take 2d10 DMG after.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000057","range":[3,3],"text":"<strong>Daytona (150cr).</strong> Gain an extra action for 1d10 turns. Reduce Speed by 1d10 after.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000058","range":[4,4],"text":"<strong>Triumph (300cr).</strong> Grants [+] on the next 1d10 rolls. 1d5 Stress. Permanently reduce Max Health by 1d5.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000059","range":[5,5],"text":"<strong>Soma (125cr).</strong> Don't gain Stress for 1d10 hours. [-] on Speed Checks for the next 1d10 days. +1 Minimum Stress.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000060","range":[6,6],"text":"<strong>Ruckus (100cr).</strong> +1d10 Strength. -1d10 Sanity.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000061","range":[7,7],"text":"<strong>Seed (350cr).</strong> Gain a new Skill for 1d10 days. Lower a random Skill's bonus by 5. A Skill reduced below 0 is forgotten completely.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000062","range":[8,8],"text":"<strong>Stimspice (500cr).</strong> Grants the ability to read target's mind for 1d10 minutes. Gain 1d5 Stress.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000063","range":[9,9],"text":"<strong>Slug (25cr).</strong> Mentally visit a virtual world shared by everyone taking Slug at that exact moment. Lasts 1d10 hours. Sanity Save.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000064","range":[10,10],"text":"<strong>Sycorax (750cr).</strong> +20 to Body Saves for cybermod installation. Heals Xd10 where X = slots installed. Addictive with mutation risk.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblInfection","name":"Infection Table","img":"","description":"<p>Effects based on ACMD Infection Level (1-10).</p>","results":[{"_id":"APOFrslt00000065","range":[1,1],"text":"<strong>Level 1:</strong> Weak immune system. All Body Saves at [-].","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000066","range":[2,2],"text":"<strong>Level 2:</strong> Once/day make a Body Save or go into a coughing fit for 1d5 rounds. Anyone within Close Range must make an Infection Check.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000067","range":[3,3],"text":"<strong>Level 3:</strong> Fever and chills. Suffer 1d5 DMG per day.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000068","range":[4,4],"text":"<strong>Level 4:</strong> Gain a random Mutation.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000069","range":[5,5],"text":"<strong>Level 5:</strong> Frailty. All Strength and Speed Checks are at [-]. Gain Mutation.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000070","range":[6,6],"text":"<strong>Level 6:</strong> Suffer 1d10 DMG per day. Endure a Random Malfunction.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000071","range":[7,7],"text":"<strong>Level 7:</strong> Panic Check. [+] on Reaping Checks until cured. Gain Mutation.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000072","range":[8,8],"text":"<strong>Level 8:</strong> Install 1 cybermod per week or gain 1d10 Stress. Gain Mutation.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000073","range":[9,9],"text":"<strong>Level 9:</strong> Once/day make a Body Save or spew an infectious Nanoswarm. All in Close Range must make an Infection Check at [-]. Gain Mutation.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000074","range":[10,10],"text":"<strong>Level 10:</strong> Lose control of the character and transform into Chokespawn.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblDoptownEc","name":"Doptown Encounters","img":"","description":"<p>Roll once per change of location in Doptown.</p>","results":[{"_id":"APOFrslt00000075","range":[1,1],"text":"<strong>Chokespawn:</strong> Running rampant and attacking Doptownians. Always stops to consume bodies.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000076","range":[2,2],"text":"<strong>Deceased O2 Beggar.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000077","range":[3,3],"text":"<strong>O2 Beggar:</strong> Cardboard sign of a clock showing how many hours the beggar has left to live. Those who don't donate must make a Sanity Save.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000078","range":[4,4],"text":"<strong>O2 Beggars, Family of Three:</strong> Child has a sign that says \"Paying for my father's sins.\" Those who don't donate must make a Sanity Save.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000079","range":[5,5],"text":"<strong>2d10 Beggars:</strong> Group of desperate beggars mob you for O2, credits, weapons, anything. Just anything.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000080","range":[6,6],"text":"<strong>1d10 Scavengers:</strong> Going from home to home collecting O2 tanks from the dead.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000081","range":[7,7],"text":"<strong>1d5 Tempest Armored Troopers:</strong> Patrolling. Harassing and murdering those who approach too closely or annoy them.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000082","range":[8,8],"text":"<strong>Standoff:</strong> 1d5 Tempest Armored Troopers vs 2 Hunglung Snipers. Tempest mercs pinned down, calling for reinforcements.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000083","range":[9,9],"text":"<strong>1d5 Hunglung Insurgency Recruiters:</strong> Want to take you to speak with Imogene Kane. They have snipers on you.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000084","range":[10,10],"text":"<strong>Imogene Kane:</strong> Leader of the Hunglungs. Has \"gills\" from Dr. Bancali. Seeking volunteers to infiltrate The Ice Box through Caliban's Heart.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblChokeEncn","name":"The Choke/Sink Encounters","img":"","description":"<p>Roll for encounters every hour in The Sink or once per location change.</p>","results":[{"_id":"APOFrslt00000085","range":[1,1],"text":"<strong>Discarded O2 tank.</strong> 1d10hrs remaining.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000086","range":[2,2],"text":"<strong>Septic Wave.</strong> Fear Save or be split up.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000087","range":[3,3],"text":"<strong>Sink hole.</strong> Body Save or fall to lower level. Take 1d10 DMG.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000088","range":[4,4],"text":"<strong>Doptownian</strong> looking for a place to die.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000089","range":[5,5],"text":"<strong>2d10 Hunglungs</strong> [C:25 Spears 1d10+1 DMG I:25 W:1] waiting in ambush.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000090","range":[6,6],"text":"<strong>1d10 Hunglung Engineers</strong> heading to Life Support 01, dragging a huge replacement filter. Without help, they won't survive the trip.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000091","range":[7,7],"text":"<strong>1d5 Tempest Operators</strong> [C:35 Pulse Rifle 3d10 DMG I:25 W:2], lost and paranoid.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000092","range":[8,8],"text":"<strong>Chokespawn</strong> (roll on Chokespawn Generator table).","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000093","range":[9,9],"text":"<strong>1d10 Chokespawn</strong> (roll on Chokespawn Generator table for each).","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000094","range":[10,10],"text":"<strong>The Wire Man:</strong> 10 story tall faceless behemoth built entirely of wires. Stomps reverberate across The Sink. Easy to hide from but he peers into cracks and broken windows. Massive Swipe: 1d100 DMG Body Save to avoid. Wounds 5(200). Retreats after gaining a Wound.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblChkspnBse","name":"Chokespawn - Base Form","img":"","description":"<p>Roll to determine a Chokespawn's base form.</p>","results":[{"_id":"APOFrslt00000095","range":[1,1],"text":"<strong>Disfigured Human Child</strong> C:20 1d5 DMG I:20 W:1","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000096","range":[2,2],"text":"<strong>1d10 Skittering Rats</strong> C:30 1d10 DMG I:25 W:1","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000097","range":[3,3],"text":"<strong>1d10 Feral Dogs</strong> C:45 2d10 DMG I:55 W:1(15)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000098","range":[4,4],"text":"<strong>Infected Hybrid Human</strong> C:50 2d10 DMG I:45 W:2(10)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000099","range":[5,5],"text":"<strong>2d10 Throbbing Eggs</strong> C:0 I:0 W:2(20)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000100","range":[6,6],"text":"<strong>Centipede of Discarded Limbs</strong> C:65 3d10 DMG I:70 W:3(40)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000101","range":[7,7],"text":"<strong>Mechanical Spider</strong> C:70 3d10 DMG I:75 W:4(12)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000102","range":[8,8],"text":"<strong>Tangled Wires & Cables</strong> C:75 4d10 DMG I:50 W:3(30)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000103","range":[9,9],"text":"<strong>Pulsating Flesh Sack</strong> C:0 I:10 W:1(100)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000104","range":[10,10],"text":"<strong>Grotesque (2 Unique Features)</strong> C:65 1d100 DMG I:45 W:3(50)","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblChkspnFtr","name":"Chokespawn - Unique Feature","img":"","description":"<p>Roll to determine a Chokespawn's unique feature.</p>","results":[{"_id":"APOFrslt00000105","range":[1,1],"text":"<strong>Hideous:</strong> Gain 1 Stress on viewing. Fear Save or cower for 1d5 [+] rounds.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000106","range":[2,2],"text":"<strong>Survivor:</strong> +10 to Combat, +1d10 DMG, +1 Wounds, +5 Health.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000107","range":[3,3],"text":"<strong>Machine-mesh:</strong> Overflowing with cybermods. AP: 10.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000108","range":[4,4],"text":"<strong>Conjoined:</strong> Roll 2nd Base Form, take highest Stats, +1 Special Attack.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000109","range":[5,5],"text":"<strong>Cocoon:</strong> Inert. Hatches after 1d10 rounds with +10 Combat and +10 DMG.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000110","range":[6,6],"text":"<strong>Mass of Limbs:</strong> Can act 1d5 times/round. +1 Special Attack.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000111","range":[7,7],"text":"<strong>Egg sack:</strong> After taking 20 DMG the sack splits and spews 1d10 Chokespawn.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000112","range":[8,8],"text":"<strong>Morph:</strong> After 1d5 rounds changes Base Form. Add new form's Wounds and DMG.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000113","range":[9,9],"text":"<strong>Mitosis:</strong> Every 1d10 rounds divides into a copy of the first creature.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000114","range":[10,10],"text":"<strong>Engorged:</strong> 3x as large as normal. +3 Wounds. Double damage.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblChkspnAtk","name":"Chokespawn - Special Attack","img":"","description":"<p>Roll to determine a Chokespawn's special attack.</p>","results":[{"_id":"APOFrslt00000115","range":[1,1],"text":"<strong>Begs You To Kill It:</strong> Sanity Save each round it begs.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000116","range":[2,2],"text":"<strong>Crawls All Over You:</strong> Fear Save [-].","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000117","range":[3,3],"text":"<strong>Howl:</strong> 50% chance 1d5 identical Chokespawn arrive in 1d10 rounds.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000118","range":[4,4],"text":"<strong>Acid Vomit:</strong> Body Save or Armor destroyed.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000119","range":[5,5],"text":"<strong>Noxious Spray:</strong> Body Save or raise your Infection Level by 1.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000120","range":[6,6],"text":"<strong>Swallow:</strong> Body Save or be ingested whole. 1d10 DMG/round until it takes a Wound.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000121","range":[7,7],"text":"<strong>Infect:</strong> Make an Infection Check whenever you are hit.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000122","range":[8,8],"text":"<strong>Snatch:</strong> Body Save or be grabbed and knocked prone. Next attack auto hits.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000123","range":[9,9],"text":"<strong>Pseudopod:</strong> New limb sprouts. Chokespawn gains +1 action/round.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000124","range":[10,10],"text":"<strong>Body Snatcher:</strong> Body Save [+] or have your next turn taken by the Warden.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblBurrowsEc","name":"Burrows Encounters","img":"","description":"<p>Roll for encounters in The Burrows.</p>","results":[{"_id":"APOFrslt00000125","range":[1,2],"text":"<strong>Nothing.</strong> The walls pulsate and throb.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000126","range":[3,3],"text":"<strong>1 Confused Husk.</strong> Wounds 1 (5).","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000127","range":[4,4],"text":"<strong>Mouth forms and spews bile.</strong> Body Save or Armor no longer protects from Infection.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000128","range":[5,5],"text":"<strong>Chamber becomes engorged.</strong> Room squeezes shut until it takes 30 DMG. Body Save to escape or 1d10 DMG per round.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000129","range":[6,6],"text":"<strong>Eye stalk sprouts.</strong> If not killed within one round of appearing, next encounter roll is at +3.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000130","range":[7,7],"text":"<strong>Grasping veins.</strong> Random character must Body Save or be sucked into the walls and sent to Room 3.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000131","range":[8,8],"text":"<strong>1d10 Husks.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000132","range":[9,9],"text":"<strong>2d10 Husks.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000133","range":[10,10],"text":"<strong>1d10 Husks, 1 Chokespawn.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblBurrowsSp","name":"Burrows Supplies","img":"","description":"<p>Roll for supplies found in The Burrows.</p>","results":[{"_id":"APOFrslt00000134","range":[1,2],"text":"<strong>O2 Tank.</strong> 1d10 hours remaining.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000135","range":[3,3],"text":"<strong>Decayed Hazmat Suit.</strong> No AP.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000136","range":[4,4],"text":"<strong>Hidden Cache:</strong> 1d5 stimpaks. 1d10kcr.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000137","range":[5,7],"text":"<strong>1d5 Fruit Sacs.</strong> The Solarian Church pays highly for these (in batches of 3) which are processed into Sycorax. Must be kept in a sealed container or The Sink will ruin them.","type":0,"documentCollection":"","documentId":null,"img":"","weight":3,"drawn":false,"flags":{}},{"_id":"APOFrslt00000138","range":[8,9],"text":"<strong>1d10 Pulse Rifle Ammunition.</strong> Scattered magazines amongst decayed corpses.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000139","range":[10,10],"text":"<strong>Corpse wielding Flamethrower.</strong> Still has 1d10 canisters of fuel remaining. Wearing an exosuit.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblCourtDckt","name":"The Court - The Docket","img":"","description":"<p>Current fights scheduled at The Court.</p>","results":[{"_id":"APOFrslt00000140","range":[1,1],"text":"<strong>1d10 Doptownians</strong> [C:20 Unarmed 1d5 DMG I:20 W:1] vs <strong>1 Executioner Probate</strong> [C:30 Vibechete 3d10 DMG I:35 W:2]. <em>Odds: 1:1</em>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000141","range":[2,3],"text":"<strong>Accused</strong> vs <strong>Accuser</strong> [C:25 Vibechete 3d10 DMG I:35 W:1]. <em>Odds: 1:1</em>","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000142","range":[4,5],"text":"<strong>Accused</strong> [C:25 Spear 1d10+1 DMG I:35 W:1] vs <strong>Executioner</strong> [C:55 Electrolash 2d10 DMG I:35 W:3]. <em>Odds: 1:5</em>","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000143","range":[6,7],"text":"<strong>Advocate</strong> [C:55 Rigging Gun 1d10 DMG I:45 W:2] vs <strong>Executioner</strong> [C:55 Electrolash 2d10 DMG I:35 W:3]. <em>Odds: 1:2</em>","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000144","range":[8,8],"text":"<strong>Accused</strong> [C:25 Spear 1d10+1 DMG I:35 W:1] vs <strong>Random Pit Creature</strong>. <em>Odds: 1:10</em>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000145","range":[9,9],"text":"<strong>1d10 Traitors</strong> [C:45 Spear 1d10+1 DMG I:35 W:1] vs <strong>Chief Adjudicator Brunhildh</strong> [C:75 Antique 5d10 DMG I:75 W:4]. <em>Odds: 1:3</em>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000146","range":[10,10],"text":"<strong>2d10 Accused & 1d10 Advocates</strong> vs <strong>1d10 Chokespawn & 5 Executioners</strong>. <em>Odds: 1:2</em>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblPitCreats","name":"Pit Creatures","img":"","description":"<p>Creatures kept in The Pit at The Court.</p>","results":[{"_id":"APOFrslt00000147","range":[1,1],"text":"<strong>Infected Cyberfreak</strong> C:20 Unarmed 1d5 DMG + Infect I:20 W:3.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000148","range":[2,4],"text":"<strong>1d10 Diamond Dogs</strong> C:65 Bite/Bite/Claw 1d10 DMG I:35 W:1.","type":0,"documentCollection":"","documentId":null,"img":"","weight":3,"drawn":false,"flags":{}},{"_id":"APOFrslt00000149","range":[5,5],"text":"<strong>Sleevewraith</strong> C:70 Rusty Blade 2d10 DMG I:35 W:2. Reclamation sleeve with combat slickware.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000150","range":[6,7],"text":"<strong>Slicksquid</strong> C:65 Tentacle 4d10 DMG I:85 W:3. Combat via Slickbay, projected into The Court.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000151","range":[8,8],"text":"<strong>The Brute</strong> C:65 Swipe 5d10 DMG I:75 W:5. Giant slow mech. Swipe hits multiple targets.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000152","range":[9,9],"text":"<strong>Specimen 869</strong> C:85 Psi-Blast Sanity Save or Xd10 DMG + 1d10 Stress. I:95 W:2. X=rounds spent concentrating.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000153","range":[10,10],"text":"Roll twice and combine.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblAccusedPy","name":"Accused & What They Can Pay","img":"","description":"<p>Accused waiting for trial at The Court and what they can pay for representation.</p>","results":[{"_id":"APOFrslt00000154","range":[1,1],"text":"<strong>Golyanovo Traitor.</strong> 1d10x100cr for Advocate. However, you'll have to fight the Chief Adjudicator.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000155","range":[2,5],"text":"<strong>O2 Debtor.</strong> No money at all. Talk to Ukko/Ukka.","type":0,"documentCollection":"","documentId":null,"img":"","weight":4,"drawn":false,"flags":{}},{"_id":"APOFrslt00000156","range":[6,7],"text":"<strong>Contraband Smuggler.</strong> 50kcr and a free ride.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000157","range":[8,8],"text":"<strong>Teamster who stole from Yandee.</strong> 1d100kcr and a free ride (maximum 3 Jumps).","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000158","range":[9,9],"text":"<strong>Hunglung Insurgent.</strong> Can't afford Advocate but Imogene Kane will owe you a favor.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000159","range":[10,10],"text":"<strong>Political Prisoner.</strong> Enemy of the Teamster Union, Tempest Co., The Golyanovo II Bratva or The Solarian Church. Can get 300kcr+ if you can win the almost certainly rigged trial and survive long enough to escort them off The Dream.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblCanyonMsn","name":"CANYONHEAVY Missions","img":"","description":"<p>Missions offered by Angus at CANYONHEAVY.market.</p>","results":[{"_id":"APOFrslt00000160","range":[1,1],"text":"Infiltrate Local 32819L. Gain membership. Find dirt on Reidmar. Foment insurrection. <strong>50kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000161","range":[2,2],"text":"Infiltrate the Golyonovo II Bratva. Become a Droog for Yandee. Report secretly to Angus. <strong>25kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000162","range":[3,3],"text":"Locate and break into \"Farm Two.\" Find the formula for Sycorax production at The Farm. <strong>30mcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000163","range":[4,4],"text":"Contact Imogene Kane. Rumored Doptown. <strong>10kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000164","range":[5,5],"text":"Locate Dr. Bancali. Ask around in Doptown. <strong>100kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000165","range":[6,6],"text":"Make contact with Hideo Kieslowski. Reclusive genius rumored to be hiding in a private Slickworld in The Ice Box for over a decade. Convince him to return to reality to help with the ACMD outbreak. <strong>350kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000166","range":[7,7],"text":"Extract Anouk Falconetti. Currently held on Sublevel C. Escort her to Loshe. <strong>750kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000167","range":[8,8],"text":"Relay slickware message to Goblin X. Currently held in a high security cell at The Court. <strong>150kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000168","range":[9,9],"text":"Retrieve Brunhildh's terminal passcode. Small disc. Hidden inside her library near The Court. <strong>375kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000169","range":[10,10],"text":"Deliver Dead Drop. Visit specified private booth in Heaven and hide package. Do not open. <strong>5kcr.</strong>","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFtblMutation1","name":"Cybernetic Mutations","img":"","description":"<p>Random cybernetic mutations from ACMD infection or Sycorax use.</p>","results":[{"_id":"APOFrslt00000170","range":[0,0],"text":"Teeth enlarged and coated in metal alloy.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000171","range":[1,4],"text":"Fingers lengthen. Fingernails turn into circuit boards.","type":0,"documentCollection":"","documentId":null,"img":"","weight":4,"drawn":false,"flags":{}},{"_id":"APOFrslt00000172","range":[5,9],"text":"Eyes turn black. Wires spread from irises across face.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000173","range":[10,14],"text":"Voice loses its human quality. Now choral and robotic.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000174","range":[15,19],"text":"All hair falls out, tubing protrudes from back of skull.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000175","range":[20,24],"text":"Vestigial synthetic appendage grows from ribcage.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000176","range":[25,29],"text":"Tangle of wires weave through your abdomen.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000177","range":[30,34],"text":"Metallic spinal column extrudes and pierces skin.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000178","range":[35,39],"text":"Limb consumed by mods. Misshapen metal mass.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000179","range":[40,44],"text":"Metallic fingers sprout from limb.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000180","range":[45,49],"text":"Hand permanently fuses with equipped weapon.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000181","range":[50,54],"text":"Semi-organic vents form in underarms and neck.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000182","range":[55,59],"text":"Insectile eyes cluster across your face.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000183","range":[60,64],"text":"Tongue grows six times normal length. Constant drool.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000184","range":[65,69],"text":"Neck grows an extra foot and is sheathed in metal.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000185","range":[70,73],"text":"Heavy organic sac swells across your hunchback.","type":0,"documentCollection":"","documentId":null,"img":"","weight":4,"drawn":false,"flags":{}},{"_id":"APOFrslt00000186","range":[74,75],"text":"Neck vents grow and emit periodic exhaust fumes.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000187","range":[76,77],"text":"Half of face melts away revealing metal skull.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000188","range":[78,79],"text":"Spiked prongs extrude from your shoulders.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000189","range":[80,80],"text":"Patch of 2d10 synthetic eyes grow out of your back.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000190","range":[81,81],"text":"Arms grow until your hands touch the floor and drag.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000191","range":[82,82],"text":"Metallic, wiry antlers grow from your skull.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000192","range":[83,83],"text":"Second face grows out of your chest.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000193","range":[84,84],"text":"Mouths form in the palms of your hands.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000194","range":[85,85],"text":"Hair turns to thick black wires, always seeking ports.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000195","range":[86,86],"text":"Fingers fuse together and turn into metal claws.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000196","range":[87,87],"text":"Mouth splits into impossibly wide smile. Metal throat.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000197","range":[88,88],"text":"Spines grow out of your arm bones.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000198","range":[89,89],"text":"Your skin becomes a liquid metal surface.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000199","range":[90,90],"text":"Hoses grow from your torso and drag along the floor.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000200","range":[91,91],"text":"The features of your face constantly drip and shift.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000201","range":[92,92],"text":"Sensitive antennae grow from your skull.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000202","range":[93,93],"text":"Your skin grows a tiny swarm of metal tentacles.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000203","range":[94,94],"text":"Prehensile tail of wire and bone.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000204","range":[95,95],"text":"Entire body becomes shifting swarm of nanobots.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000205","range":[96,96],"text":"Keyboard keys sprout from your arms.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000206","range":[97,97],"text":"A small person grows out of your torso.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000207","range":[98,98],"text":"All your skin sloughs off to reveal a metal skeleton.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000208","range":[99,99],"text":"Roll twice and combine.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d100-1","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
