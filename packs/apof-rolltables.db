with flashing colored lights.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000220","range":[50,54],"text":"Flask of station hooch.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000221","range":[55,59],"text":"Artisanal chocolate (relieves 2 Stress).","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000222","range":[60,64],"text":"Patch: \"SUKA\".","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000223","range":[65,69],"text":"Crossbow with 2d10 bolts.","type":0,"documentCollection":"","documentId":null,"img":"","weight":5,"drawn":false,"flags":{}},{"_id":"APOFrslt00000224","range":[70,73],"text":"Intact Panzerfist cybermod.","type":0,"documentCollection":"","documentId":null,"img":"","weight":4,"drawn":false,"flags":{}},{"_id":"APOFrslt00000225","range":[74,75],"text":"Map to a credit stash in The Sink.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000226","range":[76,77],"text":"SMG + 2 clips (non-frangible ammo).","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000227","range":[78,79],"text":"Adjudicator Guard's modified Stun Baton. 1d10 DMG.","type":0,"documentCollection":"","documentId":null,"img":"","weight":2,"drawn":false,"flags":{}},{"_id":"APOFrslt00000228","range":[80,80],"text":"Cryopack. Three human fingers. Fingerprints intact.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000229","range":[81,81],"text":"The Lottery Man by Benno von Archimboldi.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000230","range":[82,82],"text":"One shot mini flame thrower.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000231","range":[83,83],"text":"CalixQ's autograph on holopic. Worth 3d10x100cr.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000232","range":[84,84],"text":"Dose of Sycorax.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000233","range":[85,85],"text":"Well thumbed copy of The Grasshopper Lies Heavy.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000234","range":[86,86],"text":"\"Nemo\" journal, recounting 4 days prior to a Sleeving.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000235","range":[87,87],"text":"Pipe bomb 3d10 damage, Close Range.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000236","range":[88,88],"text":"Subversive anti-corporate Samizdat literature.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000237","range":[89,89],"text":"A small bottle of Tendre Poison eau de toilette.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000238","range":[90,90],"text":"Dog-eared copy of the Orange Catholic Bible.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000239","range":[91,91],"text":"O2 tank with 1d10 hours remaining.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000240","range":[92,92],"text":"Inactive robotic spider named Icarus. Needs repair.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000241","range":[93,93],"text":"Sheathed zipgun with six bullets.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000242","range":[94,94],"text":"La Boussole des précieux, by Pierre Menard.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000243","range":[95,95],"text":"A holomap of Caliban's Heart.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000244","range":[96,96],"text":"Writhing cyberworm. Worth 1d10x1kcr.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000245","range":[97,97],"text":"Tattooed piece of preserved skin.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000246","range":[98,98],"text":"Raggedy broken doll. Still talks.","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}},{"_id":"APOFrslt00000247","range":[99,99],"text":"Tempest Co. exosuit. Tagged: \"MAMA TRIED.\"","type":0,"documentCollection":"","documentId":null,"img":"","weight":1,"drawn":false,"flags":{}}],"formula":"1d100-1","replacement":true,"displayRoll":true,"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
