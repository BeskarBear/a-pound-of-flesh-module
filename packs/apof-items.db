{"_id":"APOFhackSplintrm","name":"Splintermask","type":"item","img":"","system":{"description":"<p>Transparent, flexible balaclava whose outer surface transmits harsh jagged noise-patterns, defeating conventional and IR cameras. Stressful to Androids/AI systems.</p>","cost":"3kcr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackRacketbl","name":"Racketball","type":"item","img":"","system":{"description":"<p>Bundle of transmitters, speakers, LEDs and suspicious cabling which aggressively output noise on all spectrums, destroying any delicate sensors within 30m and stunning standard sensors for 1d10min.</p>","cost":"4.5kcr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackOfficeAs","name":"Office Assistant","type":"item","img":"","system":{"description":"<p>A large suitcase or backpack containing blank Android personality storage and several I/O cables. A willing android can download a copy of their personality into the device which if then connected to an unwilling android (Sanity Save to resist) can control this new body, locking the original personality out.</p>","cost":"55kcr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackMoebiusS","name":"Moebius Strip","type":"item","img":"","system":{"description":"<p>If connected to a camera, endlessly replays 30 seconds of selected footage while increasing the timestamp accordingly.</p>","cost":"3.5kcr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackDoorstop","name":"Doorstop","type":"item","img":"","system":{"description":"<p>Small siphon-circuit which traps any open/close signal output by a door, meaning no notification of door operation is reported to the network.</p>","cost":"500cr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackRemoteAH","name":"Remote Autohacker","type":"item","img":"","system":{"description":"<p>A radio operated, preprogrammable output device allows for remote input (allowing the player to make a remote Hacking Check). Long Range.</p>","cost":"250kcr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackSlaveshot","name":"Slaveshot","type":"item","img":"","system":{"description":"<p>Close Range dart gun which on hit injects malicious code into a cybermod, allowing the hacker remote access within Long Range (Body Save to resist).</p>","cost":"15kcr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackSocketsn","name":"Socketsnake","type":"item","img":"","system":{"description":"<p>An inert, lifeless bundle of cables with a set of adaptors. Once connected to a device any further input causes the snake to thrash wildly, dealing 2d10 DMG to the user.</p>","cost":"750cr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment, 2d10 DMG"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFhackMommybrd","name":"Mommybird","type":"item","img":"","system":{"description":"<p>A heavy black cylinder filled with a huge bank of capacitors. When connected the device siphons power into the capacitors before outputting all of this charge back into the device. This takes 60 seconds.</p>","cost":"75kcr","quantity":1,"notes":"CANYONHEAVY Hacking Equipment"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFitemFruitSac","name":"Sycorax Fruit Sac","type":"item","img":"","system":{"description":"<p>Strange fruits that grow only in The Burrows deep in The Choke. The Solarian Church pays highly for these (in batches of 3) which are processed into Sycorax. Must be kept in a sealed container or The Sink will ruin them. Three fruits yield a batch of 500 pure doses (375kcr in revenue).</p>","cost":"10kcr per 3 fruits","quantity":1,"notes":"Sycorax ingredient"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFitemO2Credst","name":"O2 Credstick","type":"item","img":"","system":{"description":"<p>Issued upon disembarking at Prospero's Dream, this device acts as wallet, passport, and locator aboard the station. It must be preloaded with credits, and any debts or purchases are automatically deducted from it (taxes and fees are automatically withdrawn daily). Your movements are tracked.</p>","cost":"Free (mandatory)","quantity":1,"notes":"Station currency/ID"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFitemO2Tank01","name":"O2 Tank","type":"item","img":"","system":{"description":"<p>Portable oxygen supply. Essential for survival in The Choke where oxygen is scarce. Without oxygen in The Choke, you're at disadvantage to all rolls and must make a Body Save once per day to stay conscious.</p>","cost":"Varies","quantity":1,"notes":"1d10 hours of oxygen"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFitemExosuit1","name":"Exosuit","type":"item","img":"","system":{"description":"<p>Heavy powered armor suit used by Tempest Co. Armored Troopers.</p><ul><li>DR: 5</li><li>AP: 13</li><li>[+] on Strength Checks</li><li>x2 O2 tanks</li></ul>","cost":"40kcr","quantity":1,"notes":"DR:5, AP:13, [+] Strength, 2x O2"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFitemSellrLic","name":"Seller's License","type":"item","img":"","system":{"description":"<p>Allows the selling of goods aboard The Dream. Without this the crew can only make purchases.</p>","cost":"2kcr","quantity":1,"notes":"Required to sell goods"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFservSlvRecla","name":"Reclamation Sleeve","type":"item","img":"","system":{"description":"<p>Built by memory wiping prisoners. Re-roll stats. 10% chance of learning a random skill. 10% chance of gaining someone else's memories.</p>","cost":"300kcr","quantity":1,"notes":"Ice Box Service"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
{"_id":"APOFservSlvModlA","name":"Model-A Series Sleeve","type":"item","img":"","system":{"description":"<p>Bulk issue. Ten different physical models (A1-A10). Reduce all Stats and Saves by 5. Heavily discriminated against.</p>","cost":"500kcr","quantity":1,"notes":"Ice Box Service"},"effects":[],"flags":{},"folder":null,"sort":0,"_stats":{"systemId":"mosh","systemVersion":"0.6.0","coreVersion":"13","createdTime":1706832000000,"modifiedTime":1706832000000,"lastModifiedBy":"apof-module"}}
